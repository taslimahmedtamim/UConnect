{
  "name": "uconnect-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npx concurrently \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
