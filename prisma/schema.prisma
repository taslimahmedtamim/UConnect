generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  username           String?  @unique // Unique searchable handle (lowercase, alphanumeric + underscores)
  fullName           String
  email              String   @unique
  role               String   @default("student")
  bio                String?
  university         String?
  department         String?
  skills             Json     @default("[]") // Array of strings
  githubUsername     String? // GitHub handle for stats integration
  codeforcesUsername String? // Codeforces handle for stats integration
  title              String?
  location           String?
  profileImage       String?
  experience         Json     @default("[]") // Array of experience objects
  certificates       Json     @default("[]") // Array of certificate objects
  activityLog        Json     @default("{}") // Object mapping date strings to activity count
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownedTeams       Team[]        @relation("TeamOwner")
  memberTeams      Team[]        @relation("TeamMembers")
  joinRequests     JoinRequest[]
  projects         Project[]
  opportunities    Opportunity[]
  applications     OpportunityApplication[]
  messagesSent     Message[]     @relation("MessageSender")
  messagesReceived Message[]     @relation("MessageReceiver")
  userSkills       UserSkill[]
  userCareer       UserCareer?
  endorsementsGiven Endorsement[] @relation("Endorser")
  mentorProfile            MentorProfile?
  mentorshipRequestsSent     MentorshipRequest[] @relation("StudentRequests")
  mentorshipRequestsReceived MentorshipRequest[] @relation("MentorRequests")
  helpPosts                  HelpPost[]
  helpAnswers                HelpAnswer[]
  announcements              Announcement[] @relation("AnnouncementAuthor")
  pointsGiven                TeamPoint[]    @relation("PointsGiven")
  pointsReceived             TeamPoint[]    @relation("PointsReceived")
  userRoadmap                UserRoadmap?
  notifications              Notification[]
  projectComments            ProjectComment[] @relation("ProjectComments")
  projectLikes               ProjectLike[]  @relation("ProjectLikes")
  feedPosts                  FeedPost[]     @relation("FeedPosts")
  feedComments               FeedComment[]  @relation("FeedComments")
  feedLikes                  FeedLike[]     @relation("FeedLikes")
  mockInterviews             MockInterview[]
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  category    String
  tags        Json     @default("[]") // Array of strings
  repoUrl     String?
  demoUrl     String?
  lookingForContributors Boolean @default(false)
  likes       Int      @default(0)
  views       Int      @default(0)
  rating      Float    @default(4.8)
  featured    Boolean  @default(false)
  status      String   @default("In Progress")
  progress    Int      @default(10)
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features             Json     @default("[]") // For AI generated task list [{title, completed}]
  skillsDemonstrated   Json     @default("[]")
  difficulty           String?
  estimatedDuration    String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  teamId   String?
  team     Team?  @relation("TeamProjects", fields: [teamId], references: [id], onDelete: Cascade)
  
  comments ProjectComment[]
  projectLikes ProjectLike[]

  @@index([authorId])
  @@index([teamId])
}

model ProjectComment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("ProjectComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
}

model ProjectLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation("ProjectLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Opportunity {
  id           String   @id @default(uuid())
  title        String
  company      String
  type         String
  location     String
  salary       String?
  description  String   @db.Text
  requirements Json     @default("[]") // Array of strings
  postedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  postedById String
  postedBy   User   @relation(fields: [postedById], references: [id], onDelete: Cascade)
  applications OpportunityApplication[]

  @@index([postedById])
}

model OpportunityApplication {
  id            String   @id @default(uuid())
  opportunityId String
  studentId     String
  aiScore       Int      @default(0)
  aiFeedback    String?  @db.Text
  status        String   @default("pending") // 'pending', 'accepted', 'rejected'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teamId      String?
  team        Team?       @relation("TeamApplications", fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, studentId])
  @@index([opportunityId])
  @@index([studentId])
  @@index([teamId])
}

model Message {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String?
  receiver   User?   @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation("TeamMessages", fields: [teamId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([teamId])
}

model Team {
  id             String   @id @default(uuid())
  name           String
  description    String   @db.Text
  requiredSkills Json     @default("[]") // Array of strings
  assistantIds   Json     @default("[]") // Array of user IDs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId String
  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members      User[]        @relation("TeamMembers")
  joinRequests JoinRequest[]
  messages     Message[]     @relation("TeamMessages")
  announcements Announcement[] @relation("TeamAnnouncements")
  teamPoints   TeamPoint[]
  projects     Project[]     @relation("TeamProjects")
  applications OpportunityApplication[] @relation("TeamApplications")

  @@index([ownerId])
}

model TeamPoint {
  id         String   @id @default(uuid())
  teamId     String
  giverId    String
  receiverId String
  points     Int      @default(1)
  createdAt  DateTime @default(now())

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  giver      User     @relation("PointsGiven", fields: [giverId], references: [id], onDelete: Cascade)
  receiver   User     @relation("PointsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([giverId])
  @@index([receiverId])
}

model Announcement {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  
  teamId    String
  team      Team     @relation("TeamAnnouncements", fields: [teamId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([authorId])
}

model JoinRequest {
  id          String   @id @default(uuid())
  teamId      String
  userId      String
  status      String   @default("pending") // 'pending', 'approved', 'rejected'
  aiScore     Int      @default(0)
  aiFeedback  String?  @db.Text
  requestedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// U-SkillMap models
model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?  
  tags      Json     @default("[]") // array of strings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSkills       UserSkill[]
  careerPathSkills CareerPathSkill[]
}

model UserSkill {
  id             String   @id @default(uuid())
  userId         String
  skillId        String
  level          Int      @default(1) // 1..5
  endorsementCnt Int      @default(0)
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill        Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endorsements Endorsement[]

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model Endorsement {
  id          String   @id @default(uuid())
  userSkillId String
  endorserId  String
  createdAt   DateTime @default(now())

  userSkill UserSkill @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  endorser  User      @relation("Endorser", fields: [endorserId], references: [id], onDelete: Cascade)

  @@unique([userSkillId, endorserId])
  @@index([userSkillId])
  @@index([endorserId])
}

model CareerPath {
  id          String   @id @default(uuid())
  title       String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills      CareerPathSkill[]
  userCareers UserCareer[]
}

model CareerPathSkill {
  id           String   @id @default(uuid())
  careerPathId String
  skillId      String
  importance   Int      @default(3) // 1..5
  createdAt    DateTime @default(now())

  careerPath CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerPathId, skillId])
  @@index([careerPathId])
  @@index([skillId])
}

model UserCareer {
  id           String   @id @default(uuid())
  userId       String   @unique
  careerPathId String
  chosenAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerPath CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)

  @@index([careerPathId])
}

model MentorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  title           String
  company         String?
  expertise       Json     @default("[]") // Array of skill strings
  experienceYears Int      @default(3)
  availability    String?  @default("Flexible")
  bio             String?  @db.Text
  rating          Float    @default(5.0)
  reviewsCount    Int      @default(0)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MentorshipRequest {
  id          String    @id @default(uuid())
  mentorId    String
  studentId   String
  topic       String
  message     String    @db.Text
  status      String    @default("pending") // 'pending', 'accepted', 'rejected', 'completed'
  scheduledAt DateTime?
  meetingUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentor  User @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  student User @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([studentId])
}

model HelpPost {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  category  String   @default("General") // 'Frontend', 'Backend', 'DevOps', 'AI & Data', 'Security', 'Career'
  tags      Json     @default("[]")
  status    String   @default("open") // 'open', 'solved'
  views     Int      @default(0)
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  answers HelpAnswer[]

  @@index([authorId])
  @@index([category])
}

model HelpAnswer {
  id         String   @id @default(uuid())
  content    String   @db.Text
  isAccepted Boolean  @default(false)
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postId String
  post   HelpPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}


model UserRoadmap {
  id           String   @id @default(uuid())
  userId       String   @unique
  careerGoal   String
  currentLevel String
  learningTime String
  learningGoal String
  roadmapData  Json     // AI generated roadmap
  progressData Json     // Progress, streaks, completed tasks, assessments
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'mentorship_accepted', 'mentorship_rejected', 'team_joined', 'new_message', 'application_reviewed'
  title     String
  message   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model FeedPost {
  id        String   @id @default(uuid())
  content   String   @db.Text
  postType  String   @default("General") // 'General', 'Help Needed', 'Project Showcase'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId  String
  author    User     @relation("FeedPosts", fields: [authorId], references: [id], onDelete: Cascade)

  comments  FeedComment[]
  likes     FeedLike[]

  @@index([authorId])
  @@index([createdAt])
}

model FeedComment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("FeedComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model FeedLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation("FeedLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model MockInterview {
  id           String   @id @default(uuid())
  userId       String
  targetRole   String
  score        Int      @default(0)
  feedback     Json     @default("{}") // Overall strengths, weaknesses, tips
  qaHistory    Json     @default("[]") // Array of { question, answer, score, AI feedback }
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
